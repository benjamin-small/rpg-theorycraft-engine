{
  "stats": ["attack_power"],
  "buckets": {
    "as_sum": { "fold": "sum" },
    "as_summed_group": { "fold": "summed_group" },
    "as_product": { "fold": "product" }
  },
  "pipeline": [
    { "name": "sum_result", "expr": "attack_power * (1 + as_sum / 100)" },
