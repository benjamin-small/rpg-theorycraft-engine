{
  "name": "rtce-browser-tutorial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "sh ../scripts/build-web-wasm.sh",
    "test:wasm": "node scripts/test-wasm.mjs",
    "dev": "npm run wasm && vite",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "standalone": "node scripts/build-standalone.mjs",
    "build": "npm run wasm && npm run test:wasm && npm run build:web && npm run standalone",
    "preview": "vite preview"
  },
  "dependencies": {
    "@benjamin-small/browser-terminal": "0.2.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
